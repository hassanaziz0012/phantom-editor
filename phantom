#!/bin/bash

# Base directory of the project codebase.
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
if [ -f "$SCRIPT_DIR/audio-processing/process_audio.sh" ]; then
    BASE_DIR="$SCRIPT_DIR"
else
    BASE_DIR="/home/hassan/Desktop/programming/phantom-editor"
fi

show_usage() {
    echo "Usage: phantom <command> [arguments]"
    echo "Commands:"
    echo "  pipeline status [arguments]"
    echo "  pipeline process <webcam_video> [screen_video] [--raw <raw_video>] [arguments]"
    echo "  pipeline newvideo <project_name>"
    echo "  pipeline calendar [list] [--platform <youtube|twitter|all>]"
    echo "  pipeline calendar next-date [--platform <youtube|twitter>] [--json]"
    echo "  pipeline calendar add [<project>] [--title <title>] [--url <url>] [--date <date>]"
    echo "  pipeline calendar remove [<project>] [--project <project>] [--title <title>]"
    echo "  audio process [-R|--recursive] <path>"
    echo "  edit add_bgm <path_to_video> <bgm_track> [--volume <percentage>]"
    echo "  edit attach-webcam-mask --screen <screen_video> --webcam <webcam_video> [arguments]"
    echo "  edit auto-attach-webcam --screen <screen_video> --webcam <webcam_video> [arguments]"
    echo "  edit caption <video_path> [arguments]"
    echo "  edit downscale <video_path> [arguments]"
    echo "  edit transcribe <video_path> [arguments]"
    echo "  edit transcribe-cloud <video_path> [arguments]"
    echo "  edit trim-silences <video_path> [arguments]"
    echo "  edit trim-silences-whisper <video_path> [arguments] (deprecated)"
    echo "  metadata create [<project_path>] [arguments]"
    echo "  metadata desc [<project_path>] [arguments]"
    echo "  metadata tweet [<project_path>] [arguments]"
    echo "  metadata timestamps [<captions_srt_path>] [arguments]"
    echo "  metadata read [<project_or_video_path>] [--json]"
    echo "  metadata manual <video_path>"
    echo "  metadata recommend [<project_path>] [arguments]"
    echo "  metadata prepare-recommendations [<channel>] [arguments]"
    echo "  emails broadcast --title <title> --description <desc> --url <url> [arguments]"
    echo "  reddit analyze-post <url> [--headless] [--json]"
    echo "  reddit scrape <url> [--headless] [--max-comments <int>] [--json]"
    echo "  reddit scrapesub <subreddit> [--best|--hot|--top-...] [--limit <int>] [--headless] [--json]"
    echo "  tweet [--image] [--substack] [--threads] <tweet_content>"
    echo "  ideas generate-from-comments <video> [--limit <int>] [--order <relevance|time>] [--no-export] [--json]"
    echo "  ideas generate-from-outlier <video> [--no-export] [--fresh-summary] [--json]"
    echo "  ideas export [--file <path> | --idea <text>] [arguments]"
    echo "  ideas scrape (<channel_or_file> | --channels <path>) [arguments]"
    echo "  ideas outliers [arguments]"
    echo "  yt upload <video_path>"
    echo "  yt count-uploads [<channel>] [--fresh]"
    echo "  yt print-titles [<channel>] [--fresh] [--limit <int>] [--numbered] [--reverse] [--with-id] [--json]"
    echo "  yt summarize [<video>] [--all] [--limit <int>] [arguments]"
    echo "  yt comments <video> [--limit <int>] [--order <relevance|time>] [--json]"
    echo "  shorts metadata create <folder_path> [arguments]"
    echo "  shorts metadata clean"
    echo "  shorts upload --platform <youtube|instagram|tiktok|all> <video_path>"
    echo "  shorts add-thumbnail [arguments] <video_path>"
    echo "  shorts trim [arguments]"
    echo "  substack note [<text>] [-i <images>...] [-v <video>] [--headless]"
    echo "  threads post [<text>] [--posts <file...>] [-i <images>...] [--headless]"
    echo "  review inspect <video_path> [arguments]"
    echo "  record start"
    echo "  record stop"
    echo "  docs open"
}

if [ $# -eq 0 ]; then
    show_usage
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
    pipeline)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "status" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/pipelines/current_pipeline.py" "$@"
        elif [ "$SUBCOMMAND" = "process" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom pipeline process <webcam_video> [screen_video] [arguments]"
                echo "       phantom pipeline process --raw <raw_video> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/pipelines/process_video.py" "$@"
        elif [ "$SUBCOMMAND" = "newvideo" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom pipeline newvideo <project_name>"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/pipelines/newvideo.py" "$@"
        elif [ "$SUBCOMMAND" = "calendar" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/pipelines/calendar.py" "$@"
        else
            echo "Unknown pipeline subcommand: $SUBCOMMAND"
            echo "Usage: phantom pipeline status [arguments]"
            echo "       phantom pipeline process <webcam_video> [screen_video] [arguments]"
            echo "       phantom pipeline process --raw <raw_video> [arguments]"
            echo "       phantom pipeline newvideo <project_name>"
            echo "       phantom pipeline calendar [list|next-date|add|remove] [arguments]"
            exit 1
        fi
        ;;
    audio)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "process" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom audio process [-R|--recursive] <path>"
                exit 1
            fi
            "$BASE_DIR/audio-processing/process_audio.sh" "$@"
        else
            echo "Unknown audio subcommand: $SUBCOMMAND"
            echo "Usage: phantom audio process [-R|--recursive] <path>"
            exit 1
        fi
        ;;
    edit)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "add_bgm" ]; then
            "$BASE_DIR/video-editing/add_bgm_to_video.sh" "$@"
        elif [ "$SUBCOMMAND" = "attach-webcam-mask" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit attach-webcam-mask --screen <screen_video> --webcam <webcam_video> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/video-editing/attach_webcam_mask.py" "$@"
        elif [ "$SUBCOMMAND" = "auto-attach-webcam" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit auto-attach-webcam --screen <screen_video> --webcam <webcam_video> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/video-editing/auto_attach_webcam_mask.py" "$@"
        elif [ "$SUBCOMMAND" = "caption" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit caption <video_path> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/video-editing/auto_caption.py" "$@"
        elif [ "$SUBCOMMAND" = "downscale" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit downscale <video_path> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/video-editing/downscale.py" "$@"
        elif [ "$SUBCOMMAND" = "transcribe" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit transcribe <video_path> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/video-editing/transcribe.py" "$@"
        elif [ "$SUBCOMMAND" = "transcribe-cloud" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit transcribe-cloud <video_path> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/video-editing/transcribe_cloud.py" "$@"
        elif [ "$SUBCOMMAND" = "trim-silences" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit trim-silences <video_path> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/video-editing/trim_silences.py" "$@"
        elif [ "$SUBCOMMAND" = "trim-silences-whisper" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit trim-silences-whisper <video_path> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/video-editing/trim_silences_whisper.py" "$@"
        else
            echo "Unknown edit subcommand: $SUBCOMMAND"
            echo "Usage: phantom edit add_bgm <path_to_video> <bgm_track> [--volume <percentage>]"
            echo "       phantom edit attach-webcam-mask --screen <screen_video> --webcam <webcam_video> [arguments]"
            echo "       phantom edit auto-attach-webcam --screen <screen_video> --webcam <webcam_video> [arguments]"
            echo "       phantom edit caption <video_path> [arguments]"
            echo "       phantom edit downscale <video_path> [arguments]"
            echo "       phantom edit transcribe <video_path> [arguments]"
            echo "       phantom edit transcribe-cloud <video_path> [arguments]"
            echo "       phantom edit trim-silences <video_path> [arguments]"
            echo "       phantom edit trim-silences-whisper <video_path> [arguments] (deprecated)"
            exit 1
        fi
        ;;
    metadata)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "create" ] || [ "$SUBCOMMAND" = "auto-create" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/auto_create_metadata.py" "$@"
        elif [ "$SUBCOMMAND" = "desc" ] || [ "$SUBCOMMAND" = "description" ] || [ "$SUBCOMMAND" = "auto-desc" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/auto_gen_desc.py" "$@"
        elif [ "$SUBCOMMAND" = "tweet" ] || [ "$SUBCOMMAND" = "auto-tweet" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/auto_gen_tweet.py" "$@"
        elif [ "$SUBCOMMAND" = "timestamps" ] || [ "$SUBCOMMAND" = "generate-timestamps" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/generate_timestamps.py" "$@"
        elif [ "$SUBCOMMAND" = "read" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/read_metadata.py" "$@"
        elif [ "$SUBCOMMAND" = "manual" ] || [ "$SUBCOMMAND" = "interactive" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom metadata manual <video_path>"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/create_metadata.py" "$@"
        elif [ "$SUBCOMMAND" = "recommend" ] || [ "$SUBCOMMAND" = "recommendations" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/recommendations/recommend.py" "$@"
        elif [ "$SUBCOMMAND" = "prepare-recommendations" ] || [ "$SUBCOMMAND" = "prepare-yt-recommendations" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/recommendations/prepare_yt_recommendations.py" "$@"
        else
            echo "Unknown metadata subcommand: $SUBCOMMAND"
            echo "Usage: phantom metadata create [<project_path>] [arguments]"
            echo "       phantom metadata desc [<project_path>] [arguments]"
            echo "       phantom metadata tweet [<project_path>] [arguments]"
            echo "       phantom metadata timestamps [<captions_srt_path>] [arguments]"
            echo "       phantom metadata read [<project_or_video_path>] [--json]"
            echo "       phantom metadata manual <video_path>"
            echo "       phantom metadata recommend [<project_path>] [arguments]"
            echo "       phantom metadata prepare-recommendations [<channel>] [arguments]"
            exit 1
        fi
        ;;
    emails)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "broadcast" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/emails/resend_broadcast.py" "$@"
        else
            echo "Unknown emails subcommand: $SUBCOMMAND"
            echo "Usage: phantom emails broadcast [arguments]"
            exit 1
        fi
        ;;
    reddit)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "analyze-post" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/reddit/analyze_post.py" "$@"
        elif [ "$SUBCOMMAND" = "scrape" ] || [ "$SUBCOMMAND" = "scrape-post" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/reddit/scrape_reddit_post.py" "$@"
        elif [ "$SUBCOMMAND" = "scrapesub" ] || [ "$SUBCOMMAND" = "scrape-sub" ] || [ "$SUBCOMMAND" = "scrape-subreddit" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/reddit/scrape_subreddit.py" "$@"
        else
            echo "Unknown reddit subcommand: $SUBCOMMAND"
            echo "Usage: phantom reddit analyze-post <url> [--headless] [--json]"
            echo "       phantom reddit scrape <url> [--headless] [--max-comments <int>] [--json]"
            echo "       phantom reddit scrapesub <subreddit> [--best|--hot|--top-...] [--limit <int>] [--headless] [--json]"
            exit 1
        fi
        ;;
    tweet)
        if [ $# -eq 0 ]; then
            echo "Usage: phantom tweet [--image] [--substack] [--threads] <tweet_content>"
            exit 1
        fi
        "$BASE_DIR/twitter/tweet.sh" "$@"
        ;;
    ideas)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "generate-from-comments" ] || [ "$SUBCOMMAND" = "from-comments" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom ideas generate-from-comments <video> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/ideas/comments/generate_ideas.py" "$@"
        elif [ "$SUBCOMMAND" = "generate-from-outlier" ] || [ "$SUBCOMMAND" = "from-outlier" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom ideas generate-from-outlier <video> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/ideas/generate_from_outlier.py" "$@"
        elif [ "$SUBCOMMAND" = "export" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/ideas/export_ideas_to_sheet.py" "$@"
        elif [ "$SUBCOMMAND" = "outliers" ]; then
            uv run --project "$BASE_DIR" python -m ideas.outliers_db "$@"
        elif [ "$SUBCOMMAND" = "scrape" ] || [ "$SUBCOMMAND" = "scrape-videos" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/ideas/scrape_videos.py" "$@"
        else
            echo "Unknown ideas subcommand: $SUBCOMMAND"
            echo "Usage: phantom ideas generate-from-comments <video> [arguments]"
            echo "       phantom ideas generate-from-outlier <video> [arguments]"
            echo "       phantom ideas export [--file <path> | --idea <text>] [arguments]"
            echo "       phantom ideas scrape (<channel_or_file> | --channels <path>) [arguments]"
            echo "       phantom ideas outliers [arguments]"
            exit 1
        fi
        ;;
    yt)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "upload" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/youtube_api/upload_video.py" "$@"
        elif [ "$SUBCOMMAND" = "count-uploads" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/youtube_api/count_youtube_uploads.py" "$@"
        elif [ "$SUBCOMMAND" = "print-titles" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/youtube_api/print_titles.py" "$@"
        elif [ "$SUBCOMMAND" = "summarize" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/ideas/summarize_video.py" "$@"
        elif [ "$SUBCOMMAND" = "comments" ] || [ "$SUBCOMMAND" = "scrape-comments" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/ideas/comments/scrape_comments.py" "$@"
        else
            echo "Unknown yt subcommand: $SUBCOMMAND"
            echo "Usage: phantom yt upload <video_path>"
            echo "       phantom yt count-uploads [<channel>] [--fresh]"
            echo "       phantom yt print-titles [<channel>] [--fresh] [--limit <int>] [--numbered] [--reverse] [--with-id] [--json]"
            echo "       phantom yt summarize [<video>] [--all] [--limit <int>] [arguments]"
            echo "       phantom yt comments <video> [--limit <int>] [--order <relevance|time>] [--json]"
            exit 1
        fi
        ;;
    shorts)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "metadata" ]; then
            METADATA_CMD="$1"
            shift
            if [ "$METADATA_CMD" = "create" ]; then
                if [ $# -eq 0 ]; then
                    echo "Usage: phantom shorts metadata create <folder_path> [arguments]"
                    exit 1
                fi
                uv run --project "$BASE_DIR" python "$BASE_DIR/shorts/create_bulk_metadata.py" "$@"
            elif [ "$METADATA_CMD" = "clean" ]; then
                uv run --project "$BASE_DIR" python "$BASE_DIR/shorts/clean_metadata.py" "$@"
            else
                echo "Unknown shorts metadata subcommand: $METADATA_CMD"
                echo "Usage: phantom shorts metadata create <folder_path> [arguments]"
                echo "       phantom shorts metadata clean"
                exit 1
            fi
        elif [ "$SUBCOMMAND" = "upload" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/shorts/upload.py" "$@"
        elif [ "$SUBCOMMAND" = "add-thumbnail" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/shorts/add_thumbnail.py" "$@"
        elif [ "$SUBCOMMAND" = "trim" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/shorts/auto_trim_shorts.py" "$@"
        else
            echo "Unknown shorts subcommand: $SUBCOMMAND"
            echo "Usage: phantom shorts metadata create <folder_path> [arguments]"
            echo "       phantom shorts metadata clean"
            echo "       phantom shorts upload --platform <youtube|instagram|tiktok|all> <video_path>"
            echo "       phantom shorts add-thumbnail [arguments] <video_path>"
            echo "       phantom shorts trim [arguments]"
            exit 1
        fi
        ;;
    docs)
        SUBCOMMAND="$1"
        shift
        
        open_url() {
            local url="$1"
            if command -v explorer.exe >/dev/null 2>&1; then
                explorer.exe "$url" >/dev/null 2>&1 || true
            elif command -v xdg-open >/dev/null 2>&1; then
                xdg-open "$url" >/dev/null 2>&1 || true
            else
                python3 -m webbrowser "$url" >/dev/null 2>&1 || true
            fi
        }

        if [ "$SUBCOMMAND" = "open" ]; then
            # Check if port 8000 is already in use
            if python3 -c "import socket; s = socket.socket(socket.AF_INET, socket.SOCK_STREAM); s.settimeout(1); s.connect(('127.0.0.1', 8000))" 2>/dev/null; then
                echo "Docs server is already running on http://127.0.0.1:8000"
                echo "Opening browser..."
                open_url "http://127.0.0.1:8000"
                exit 0
            else
                echo "Starting docs server on http://127.0.0.1:8000..."
                uv run --project "$BASE_DIR" mkdocs serve &
                SERVER_PID=$!
                
                # Set trap to ensure server is cleaned up when script exits
                trap 'kill $SERVER_PID 2>/dev/null' EXIT INT TERM
                
                # Wait 2 seconds for server to start
                sleep 2
                
                echo "Opening browser..."
                open_url "http://127.0.0.1:8000"
                
                # Keep script running to show server output
                wait $SERVER_PID
            fi
        else
            echo "Unknown docs subcommand: $SUBCOMMAND"
            echo "Usage: phantom docs open"
            exit 1
        fi
        ;;
    review)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "inspect" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom review inspect <video_path> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/review/video_inspector.py" "$@"
        else
            echo "Unknown review subcommand: $SUBCOMMAND"
            echo "Usage: phantom review inspect <video_path> [arguments]"
            exit 1
        fi
        ;;
    substack)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "note" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/substack/post_note.py" "$@"
        else
            echo "Unknown substack subcommand: $SUBCOMMAND"
            echo "Usage: phantom substack note [<text>] [-i <images>...] [-v <video>] [--headless]"
            exit 1
        fi
        ;;
    threads)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "post" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/threads/post_thread.py" "$@"
        else
            echo "Unknown threads subcommand: $SUBCOMMAND"
            echo "Usage: phantom threads post [<text>] [--posts <file...>] [-i <images>...] [--headless]"
            exit 1
        fi
        ;;
    record)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "start" ] || [ "$SUBCOMMAND" = "stop" ]; then
            SCRIPT_PATH=$(wslpath -w "$BASE_DIR/recording/record_in_sync.py")
            python.exe "$SCRIPT_PATH" "$SUBCOMMAND" "$@"
        else
            echo "Unknown record subcommand: $SUBCOMMAND"
            echo "Usage: phantom record start"
            echo "       phantom record stop"
            exit 1
        fi
        ;;
    *)
        echo "Unknown command: $COMMAND"
        show_usage
        exit 1
        ;;
esac
