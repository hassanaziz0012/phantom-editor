#!/bin/bash

# Base directory of the project codebase.
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
if [ -f "$SCRIPT_DIR/audio-processing/process_audio.sh" ]; then
    BASE_DIR="$SCRIPT_DIR"
else
    BASE_DIR="/home/hassan/Desktop/programming/phantom-editor"
fi

# Clean up external VIRTUAL_ENV so uv targets the project environment without warnings
unset VIRTUAL_ENV

# Every command, one per line: group ; names ; flags ; target ; usage
#   group   "projects", or two words ("research reddit") for a nested group
#   names   comma-separated; the first is shown in help, the rest are old aliases
#   flags   r = needs at least one argument, k = pass the subcommand on to the target
#   target  "py <file>" runs it with the project's Python, "run <file>" runs it directly,
#           anything else is a function in this script
# Help, each group's usage and dispatch are all generated from this table.
COMMANDS=(
    "projects;status;;py projects/current_pipeline.py;[arguments]"
    "projects;process;r;py projects/process_video.py;<raw_video> [arguments]"
    "projects;newvideo;r;py projects/newvideo.py;<project_name>"
    "projects;cleanup;;py projects/cleanup.py;[<project_path>] [--full]"

    "edit;add-bgm,add_bgm;;run video-editing/add_bgm_to_video.sh;<path_to_video> <bgm_track> [--volume <percentage>]"
    "edit;process-audio;r;run audio-processing/process_audio.sh;[-R|--recursive] <path>"
    "edit;inspect-video;r;py review/video_inspector.py;<video_path> [arguments]"
    "edit;review-audio;r;py review/audio_review.py;<video_or_audio_path> [arguments]"
    "edit;caption;r;py video-editing/auto_caption.py;<video_path> [arguments]"
    "edit;downscale;r;py video-editing/downscale.py;<video_path> [arguments]"
    "edit;transcribe-cloud;r;py video-editing/transcribe_cloud.py;<video_path> [arguments]"
    "edit;trim-silences;r;py video-editing/trim_silences.py;<video_path> [arguments]"

    "meta;create,auto-create;;py metadata/auto_create_metadata.py;[<project_path>] [arguments]"
    "meta;desc,description,auto-desc;;py metadata/auto_gen_desc.py;[<project_path>] [arguments]"
    "meta;tweet,auto-tweet;;py metadata/auto_gen_tweet.py;[<project_path>] [arguments]"
    "meta;timestamps,generate-timestamps;;py metadata/generate_timestamps.py;[<captions_srt_path>] [arguments]"
    "meta;titles,generate-titles;;py metadata/generate_titles.py;[<project_path>] [--traffic <search|browse|both>] [--channel-size <small|mid|large>] [--thumbnail <concept>]"
    "meta;resources,check-resource-links;;py metadata/check_resource_links.py;[<project_path>] [arguments]"
    "meta;read;;py metadata/read_metadata.py;[<project_or_video_path>] [--json]"
    "meta;manual,interactive;r;py metadata/create_metadata.py;<video_path>"
    "meta;recommend,recommendations;;py metadata/recommendations/recommend.py;[<project_path>] [arguments]"
    "meta;prepare-recommendations,prepare-yt-recommendations;;py metadata/recommendations/prepare_yt_recommendations.py;[<channel>] [--limit <int>] [--force] [--fresh] [--json]"

    "publish;yt,youtube;;py youtube_api/upload_video.py;<video_path> [--playlist <playlist_id_or_name>]"
    "publish;x,tweet,twitter;r;run twitter/tweet.sh;[--image] [--substack] <tweet_content>"
    "publish;substack;;py substack/post_note.py;[<text>] [-f <file>] [-i <images>...] [-v <video>] [--headless]"
    "publish;linkedin;;py linkedin/new_post.py;[<text>] [-f <file>] [-i <images>...] [--url <url>]"
    "publish;devto;;py devto/post.py;<markdown_file> [-t <title>] [--tags <tags>...] [-c <cover>] [--canonical-url <url>] [--series <name>] [--schedule \"YYYY-MM-DD HH:MM\"] [--draft]"
    "publish;email,emails;;py emails/resend_broadcast.py;--title <title> --description <desc> --url <url> [arguments]"
    "publish;yap;;py content/yap_to_post.py;--platform <linkedin|substack>"

    "research reddit;post,scrape,scrape-post;;py reddit/scrape_reddit_post.py;<url> [--headless] [--max-comments <int>] [--json]"
    "research reddit;analyze,analyze-post;;py reddit/analyze_post.py;<url> [--headless] [--json]"
    "research reddit;sub,scrapesub,scrape-sub,scrape-subreddit;;py reddit/scrape_subreddit.py;<subreddit> [--best|--hot|--top-...] [--limit <int>] [--headless] [--json]"
    "research reddit;search,scrapesearch,scrape-search;;py reddit/scrape_search.py;<query> [--sort <sort>] [--time <time>] [--limit <int>] [--headless] [--json]"
    "research reddit;profile,scrape-profile,user;;py reddit/scrape_profile.py;<username_or_url> [--posts <int>] [--comments <int>] [--sort <sort>] [--time <time>] [--json]"
    "research reddit;serve;;py reddit/serve.py;[--port <int>] [--headless]   (answers post/feed scrape requests as JSON lines on stdin)"
    "research skool;post,scrape,scrape-post;;py skool/scrape_post.py;<url> [--max-comments <int>] [--headless] [--json]"
    "research skool;community,scrapecommunity,scrape-community;;py skool/scrape_community.py;<url_or_slug> [--limit <int>] [-o|--output <file>] [--headless] [--json]"

    "ideas;from-comments,generate-from-comments;r;py ideas/comments/generate_ideas.py;<video> [--limit <int>] [--order <relevance|time>] [--no-export] [--json]"
    "ideas;from-outlier,generate-from-outlier;r;py ideas/generate_from_outlier.py;<video> [--no-export] [--fresh-summary] [--json]"
    "ideas;export;;py ideas/export_ideas_to_sheet.py;[--file <path> | --idea <text>] [arguments]"
    "ideas;archive;;py ideas/archive_reviewed_ideas.py;[--dry-run]"

    "yt;add-to-playlist,addtoplaylist;;py youtube_api/addtoplaylist.py;<video> <playlist_id_or_name> [--privacy <public|unlisted|private>]"
    "yt;count-uploads;;py youtube_api/count_youtube_uploads.py;[<channel>] [--fresh]"
    "yt;titles,print-titles;;py youtube_api/print_titles.py;[<channel>] [--fresh] [--limit <int>] [--numbered] [--reverse] [--with-id] [--json]"
    "yt;summarize;;py ideas/summarize_video.py;<video> [--model <model>] [--json]"
    "yt;comments,scrape-comments;;py ideas/comments/scrape_comments.py;<video> [--limit <int>] [--order <relevance|time>] [--json]"
    "yt;info;;py youtube_api/video_info.py;<video> [--fresh] [--json] [--days <int>]"
    "yt;channel-stats;;py youtube_api/channel_stats.py;[--fresh] [--json] [--history]"
    "yt;endscreen;;py youtube_api/add_endscreen.py;<video>... [--template <name>] [--dry-run]"

    "broll;list;k;py broll-templates/broll.py;[<template>]"
    "broll;find;k;py broll-templates/broll.py;<phrase> [--srt <word_srt>] [--after <timestamp>]"
    "broll;render;k;py broll-templates/broll.py;<cue_file.json> [--srt <word_srt>] [--only <file>...] [--dry-run] [--force]"
    "broll;clip;k;py broll-templates/broll.py;<template> -o <output.mp4> [--cue <phrase>] [--until <phrase>] [--var key=value...] [arguments]"

    "docs;open;;docs_open;"
)

# Old command names, left out of the help: other projects still call them. Each
# rewrites the leading words of the command line into the current command.
declare -A LEGACY=(
    ["metadata"]="meta"
    ["reddit"]="research reddit"
    ["skool"]="research skool"
    ["tweet"]="publish x"
    ["yt upload"]="publish yt"
    ["audio process"]="edit process-audio"
    ["review inspect"]="edit inspect-video"
    ["review audio"]="edit review-audio"
    ["emails broadcast"]="publish email"
    ["content yap"]="publish yap"
    ["substack note"]="publish substack"
    ["linkedin post"]="publish linkedin"
    ["linkedin new-post"]="publish linkedin"
    ["devto post"]="publish devto"
)

REMOVED=("shorts" "threads" "edit attach-webcam-mask" "edit auto-attach-webcam" "edit transcribe" "edit trim-silences-whisper")

py() {
    local script="$1"
    shift
    uv run --project "$BASE_DIR" python "$BASE_DIR/$script" "$@"
}

run() {
    local script="$1"
    shift
    "$BASE_DIR/$script" "$@"
}

docs_open() {
    open_url() {
        local url="$1"
        if command -v explorer.exe >/dev/null 2>&1; then
            explorer.exe "$url" >/dev/null 2>&1 || true
        elif command -v xdg-open >/dev/null 2>&1; then
            xdg-open "$url" >/dev/null 2>&1 || true
        else
            python3 -m webbrowser "$url" >/dev/null 2>&1 || true
        fi
    }

    # Check if port 8000 is already in use
    if python3 -c "import socket; s = socket.socket(socket.AF_INET, socket.SOCK_STREAM); s.settimeout(1); s.connect(('127.0.0.1', 8000))" 2>/dev/null; then
        echo "Docs server is already running on http://127.0.0.1:8000"
        echo "Opening browser..."
        open_url "http://127.0.0.1:8000"
        return 0
    fi

    echo "Starting docs server on http://127.0.0.1:8000..."
    uv run --project "$BASE_DIR" mkdocs serve &
    SERVER_PID=$!

    # Set trap to ensure server is cleaned up when script exits
    trap 'kill $SERVER_PID 2>/dev/null' EXIT INT TERM

    # Wait 2 seconds for server to start
    sleep 2

    echo "Opening browser..."
    open_url "http://127.0.0.1:8000"

    # Keep script running to show server output
    wait $SERVER_PID
}

# Splits a COMMANDS entry into GROUP, NAMES, FLAGS, TARGET and ARGS_USAGE.
parse_entry() {
    IFS=';' read -r GROUP NAMES FLAGS TARGET ARGS_USAGE <<< "$1"
}

show_usage() {
    echo "Usage: phantom <command> [arguments]"
    echo ""
    echo "Commands:"
    local entry header last_header=""
    for entry in "${COMMANDS[@]}"; do
        parse_entry "$entry"
        header="${GROUP%% *}"
        if [ "$header" != "$last_header" ]; then
            [ -n "$last_header" ] && echo ""
            echo "  $header:"
            last_header="$header"
        fi
        # Nested groups show their second word before the command ("reddit post")
        local prefix=""
        [ "$GROUP" != "$header" ] && prefix="${GROUP#* } "
        echo "    $prefix${NAMES%%,*}${ARGS_USAGE:+ $ARGS_USAGE}"
    done
}

# Usage lines for every command in a group (or under a group header like "research").
group_usage() {
    local entry label="Usage:"
    for entry in "${COMMANDS[@]}"; do
        parse_entry "$entry"
        if [ "$GROUP" = "$1" ] || [ "${GROUP%% *}" = "$1" ]; then
            echo "$label phantom $GROUP ${NAMES%%,*}${ARGS_USAGE:+ $ARGS_USAGE}"
            label="      "
        fi
    done
}

if [ $# -eq 0 ]; then
    show_usage
    exit 1
fi

case "$1" in
    help|--help|-h)
        show_usage
        exit 0
        ;;
esac

# Rewrite old command names into current ones
if [ -n "${LEGACY["$1 $2"]+set}" ]; then
    read -r -a NEW_WORDS <<< "${LEGACY["$1 $2"]}"
    set -- "${NEW_WORDS[@]}" "${@:3}"
elif [ -n "${LEGACY["$1"]+set}" ]; then
    read -r -a NEW_WORDS <<< "${LEGACY["$1"]}"
    set -- "${NEW_WORDS[@]}" "${@:2}"
fi

for removed in "${REMOVED[@]}"; do
    if [ "$removed" = "$1" ] || [ "$removed" = "$1 $2" ]; then
        echo "phantom $removed was removed." >&2
        exit 1
    fi
done

# Find the group: two words for nested groups ("research reddit"), else one
GROUP_ARG="$1"
shift
for entry in "${COMMANDS[@]}"; do
    parse_entry "$entry"
    if [ "$GROUP" = "$GROUP_ARG $1" ]; then
        GROUP_ARG="$GROUP_ARG $1"
        shift
        break
    fi
done

SUBCOMMAND="$1"
[ $# -gt 0 ] && shift

KNOWN_GROUP=false
for entry in "${COMMANDS[@]}"; do
    parse_entry "$entry"
    [ "$GROUP" = "$GROUP_ARG" ] || [ "${GROUP%% *}" = "$GROUP_ARG" ] || continue
    KNOWN_GROUP=true
    [ "$GROUP" = "$GROUP_ARG" ] || continue
    if [[ ",$NAMES," == *",$SUBCOMMAND,"* ]] && [ -n "$SUBCOMMAND" ]; then
        if [[ "$FLAGS" == *r* ]] && [ $# -eq 0 ]; then
            echo "Usage: phantom $GROUP ${NAMES%%,*}${ARGS_USAGE:+ $ARGS_USAGE}"
            exit 1
        fi
        [[ "$FLAGS" == *k* ]] && set -- "$SUBCOMMAND" "$@"
        read -r -a CMD <<< "$TARGET"
        "${CMD[@]}" "$@"
        exit $?
    fi
done

if [ "$KNOWN_GROUP" = true ]; then
    echo "Unknown $GROUP_ARG subcommand: $SUBCOMMAND"
    group_usage "$GROUP_ARG"
else
    echo "Unknown command: $GROUP_ARG"
    show_usage
fi
exit 1
