# Old command names (reddit/skool groups, scrapesub, add_bgm, addtoplaylist,
# generate-from-*, tweet, yt upload, yt print-titles, audio process, metadata,
# review, emails/content/substack/linkedin/devto groups, ...) are still
# dispatched below but left out of the help: other projects call them. Keep
# them until those callers are migrated.

removed_command() {
    echo "phantom $1 was removed." >&2
    exit 1
}

run_reddit() {
    local SUBCOMMAND="$1"
    shift
    if [ "$SUBCOMMAND" = "post" ] || [ "$SUBCOMMAND" = "scrape" ] || [ "$SUBCOMMAND" = "scrape-post" ]; then
        uv run --project "$BASE_DIR" python "$BASE_DIR/reddit/scrape_reddit_post.py" "$@"
    elif [ "$SUBCOMMAND" = "analyze" ] || [ "$SUBCOMMAND" = "analyze-post" ]; then
        uv run --project "$BASE_DIR" python "$BASE_DIR/reddit/analyze_post.py" "$@"
    elif [ "$SUBCOMMAND" = "sub" ] || [ "$SUBCOMMAND" = "scrapesub" ] || [ "$SUBCOMMAND" = "scrape-sub" ] || [ "$SUBCOMMAND" = "scrape-subreddit" ]; then
        uv run --project "$BASE_DIR" python "$BASE_DIR/reddit/scrape_subreddit.py" "$@"
    elif [ "$SUBCOMMAND" = "search" ] || [ "$SUBCOMMAND" = "scrapesearch" ] || [ "$SUBCOMMAND" = "scrape-search" ]; then
        uv run --project "$BASE_DIR" python "$BASE_DIR/reddit/scrape_search.py" "$@"
    elif [ "$SUBCOMMAND" = "profile" ] || [ "$SUBCOMMAND" = "scrape-profile" ] || [ "$SUBCOMMAND" = "user" ]; then
        uv run --project "$BASE_DIR" python "$BASE_DIR/reddit/scrape_profile.py" "$@"
    elif [ "$SUBCOMMAND" = "serve" ]; then
        uv run --project "$BASE_DIR" python "$BASE_DIR/reddit/serve.py" "$@"
    else
        echo "Unknown reddit subcommand: $SUBCOMMAND"
        echo "Usage: phantom research reddit post <url> [--headless] [--max-comments <int>] [--json]"
        echo "       phantom research reddit analyze <url> [--headless] [--json]"
        echo "       phantom research reddit sub <subreddit> [--best|--hot|--top-...] [--limit <int>] [--headless] [--json]"
        echo "       phantom research reddit search <query> [--sort <sort>] [--time <time>] [--limit <int>] [--headless] [--json]"
        echo "       phantom research reddit profile <username_or_url> [--posts <int>] [--comments <int>] [--sort <sort>] [--time <time>] [--json]"
        echo "       phantom research reddit serve [--port <int>] [--headless]"
        exit 1
    fi
}

run_skool() {
    local SUBCOMMAND="$1"
    shift
    if [ "$SUBCOMMAND" = "post" ] || [ "$SUBCOMMAND" = "scrape" ] || [ "$SUBCOMMAND" = "scrape-post" ]; then
        uv run --project "$BASE_DIR" python "$BASE_DIR/skool/scrape_post.py" "$@"
    elif [ "$SUBCOMMAND" = "community" ] || [ "$SUBCOMMAND" = "scrapecommunity" ] || [ "$SUBCOMMAND" = "scrape-community" ]; then
        uv run --project "$BASE_DIR" python "$BASE_DIR/skool/scrape_community.py" "$@"
    else
        echo "Unknown skool subcommand: $SUBCOMMAND"
        echo "Usage: phantom research skool post <url> [--max-comments <int>] [--headless] [--json]"
        echo "       phantom research skool community <url_or_slug> [--limit <int>] [-o|--output <file>] [--headless] [--json]"
        exit 1
    fi
}

run_publish() {
    local TARGET="$1"
    shift
    if [ "$TARGET" = "yt" ] || [ "$TARGET" = "youtube" ]; then
        uv run --project "$BASE_DIR" python "$BASE_DIR/youtube_api/upload_video.py" "$@"
    elif [ "$TARGET" = "x" ] || [ "$TARGET" = "tweet" ] || [ "$TARGET" = "twitter" ]; then
        if [ $# -eq 0 ]; then
            echo "Usage: phantom publish x [--image] [--substack] <tweet_content>"
            exit 1
        fi
        "$BASE_DIR/twitter/tweet.sh" "$@"
    elif [ "$TARGET" = "substack" ]; then
        uv run --project "$BASE_DIR" python "$BASE_DIR/substack/post_note.py" "$@"
    elif [ "$TARGET" = "linkedin" ]; then
        uv run --project "$BASE_DIR" python "$BASE_DIR/linkedin/new_post.py" "$@"
    elif [ "$TARGET" = "devto" ]; then
        uv run --project "$BASE_DIR" python "$BASE_DIR/devto/post.py" "$@"
    elif [ "$TARGET" = "email" ] || [ "$TARGET" = "emails" ]; then
        uv run --project "$BASE_DIR" python "$BASE_DIR/emails/resend_broadcast.py" "$@"
    elif [ "$TARGET" = "yap" ]; then
        uv run --project "$BASE_DIR" python "$BASE_DIR/content/yap_to_post.py" "$@"
    else
        echo "Unknown publish target: $TARGET"
        echo "Usage: phantom publish yt <video_path> [--playlist <playlist_id_or_name>]"
        echo "       phantom publish x [--image] [--substack] <tweet_content>"
        echo "       phantom publish substack [<text>] [-f <file>] [-i <images>...] [-v <video>] [--headless]"
        echo "       phantom publish linkedin [<text>] [-f <file>] [-i <images>...] [--url <url>]"
        echo "       phantom publish devto <markdown_file> [arguments]"
        echo "       phantom publish email --title <title> --description <desc> --url <url> [arguments]"
        echo "       phantom publish yap --platform <linkedin|substack>"
        exit 1
    fi
}

if [ $# -eq 0 ]; then
    show_usage
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
    projects)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "status" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/projects/current_pipeline.py" "$@"
        elif [ "$SUBCOMMAND" = "process" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom projects process <raw_video> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/projects/process_video.py" "$@"
        elif [ "$SUBCOMMAND" = "newvideo" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom projects newvideo <project_name>"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/projects/newvideo.py" "$@"
        elif [ "$SUBCOMMAND" = "cleanup" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/projects/cleanup.py" "$@"
        else
            echo "Unknown projects subcommand: $SUBCOMMAND"
            echo "Usage: phantom projects status [arguments]"
            echo "       phantom projects process <raw_video> [arguments]"
            echo "       phantom projects newvideo <project_name>"
            echo "       phantom projects cleanup [<project_path>] [--full]"
            exit 1
        fi
        ;;
    audio)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "process" ]; then
            exec "$0" edit process-audio "$@"
        else
            echo "Unknown audio subcommand: $SUBCOMMAND"
            echo "Usage: phantom edit process-audio [-R|--recursive] <path>"
            exit 1
        fi
        ;;
    edit)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "add-bgm" ] || [ "$SUBCOMMAND" = "add_bgm" ]; then
            "$BASE_DIR/video-editing/add_bgm_to_video.sh" "$@"
        elif [ "$SUBCOMMAND" = "process-audio" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit process-audio [-R|--recursive] <path>"
                exit 1
            fi
            "$BASE_DIR/audio-processing/process_audio.sh" "$@"
        elif [ "$SUBCOMMAND" = "inspect-video" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit inspect-video <video_path> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/review/video_inspector.py" "$@"
        elif [ "$SUBCOMMAND" = "review-audio" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit review-audio <video_or_audio_path> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/review/audio_review.py" "$@"
        elif [ "$SUBCOMMAND" = "attach-webcam-mask" ] || [ "$SUBCOMMAND" = "auto-attach-webcam" ] \
            || [ "$SUBCOMMAND" = "transcribe" ] || [ "$SUBCOMMAND" = "trim-silences-whisper" ]; then
            removed_command "edit $SUBCOMMAND"
        elif [ "$SUBCOMMAND" = "caption" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit caption <video_path> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/video-editing/auto_caption.py" "$@"
        elif [ "$SUBCOMMAND" = "downscale" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit downscale <video_path> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/video-editing/downscale.py" "$@"
        elif [ "$SUBCOMMAND" = "transcribe-cloud" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit transcribe-cloud <video_path> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/video-editing/transcribe_cloud.py" "$@"
        elif [ "$SUBCOMMAND" = "trim-silences" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom edit trim-silences <video_path> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/video-editing/trim_silences.py" "$@"
        else
            echo "Unknown edit subcommand: $SUBCOMMAND"
            echo "Usage: phantom edit add-bgm <path_to_video> <bgm_track> [--volume <percentage>]"
            echo "       phantom edit process-audio [-R|--recursive] <path>"
            echo "       phantom edit inspect-video <video_path> [arguments]"
            echo "       phantom edit review-audio <video_or_audio_path> [arguments]"
            echo "       phantom edit caption <video_path> [arguments]"
            echo "       phantom edit downscale <video_path> [arguments]"
            echo "       phantom edit transcribe-cloud <video_path> [arguments]"
            echo "       phantom edit trim-silences <video_path> [arguments]"
            exit 1
        fi
        ;;
    meta|metadata)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "create" ] || [ "$SUBCOMMAND" = "auto-create" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/auto_create_metadata.py" "$@"
        elif [ "$SUBCOMMAND" = "desc" ] || [ "$SUBCOMMAND" = "description" ] || [ "$SUBCOMMAND" = "auto-desc" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/auto_gen_desc.py" "$@"
        elif [ "$SUBCOMMAND" = "tweet" ] || [ "$SUBCOMMAND" = "auto-tweet" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/auto_gen_tweet.py" "$@"
        elif [ "$SUBCOMMAND" = "timestamps" ] || [ "$SUBCOMMAND" = "generate-timestamps" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/generate_timestamps.py" "$@"
        elif [ "$SUBCOMMAND" = "titles" ] || [ "$SUBCOMMAND" = "generate-titles" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/generate_titles.py" "$@"
        elif [ "$SUBCOMMAND" = "resources" ] || [ "$SUBCOMMAND" = "check-resource-links" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/check_resource_links.py" "$@"
        elif [ "$SUBCOMMAND" = "read" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/read_metadata.py" "$@"
        elif [ "$SUBCOMMAND" = "manual" ] || [ "$SUBCOMMAND" = "interactive" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom meta manual <video_path>"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/create_metadata.py" "$@"
        elif [ "$SUBCOMMAND" = "recommend" ] || [ "$SUBCOMMAND" = "recommendations" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/recommendations/recommend.py" "$@"
        elif [ "$SUBCOMMAND" = "prepare-recommendations" ] || [ "$SUBCOMMAND" = "prepare-yt-recommendations" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/metadata/recommendations/prepare_yt_recommendations.py" "$@"
        else
            echo "Unknown meta subcommand: $SUBCOMMAND"
            echo "Usage: phantom meta create [<project_path>] [arguments]"
            echo "       phantom meta desc [<project_path>] [arguments]"
            echo "       phantom meta tweet [<project_path>] [arguments]"
            echo "       phantom meta timestamps [<captions_srt_path>] [arguments]"
            echo "       phantom meta titles [<project_path>] [arguments]"
            echo "       phantom meta resources [<project_path>] [arguments]"
            echo "       phantom meta read [<project_or_video_path>] [--json]"
            echo "       phantom meta manual <video_path>"
            echo "       phantom meta recommend [<project_path>] [arguments]"
            echo "       phantom meta prepare-recommendations [<channel>] [--limit <int>] [--force] [--fresh] [--json]"
            exit 1
        fi
        ;;
    emails)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "broadcast" ]; then
            run_publish email "$@"
        else
            echo "Unknown emails subcommand: $SUBCOMMAND"
            echo "Usage: phantom publish email [arguments]"
            exit 1
        fi
        ;;
    research)
        SOURCE="$1"
        shift
        if [ "$SOURCE" = "reddit" ]; then
            run_reddit "$@"
        elif [ "$SOURCE" = "skool" ]; then
            run_skool "$@"
        else
            echo "Unknown research source: $SOURCE"
            echo "Usage: phantom research reddit <post|analyze|sub|search|profile|serve> [arguments]"
            echo "       phantom research skool <post|community> [arguments]"
            exit 1
        fi
        ;;
    reddit)
        run_reddit "$@"
        ;;
    skool)
        run_skool "$@"
        ;;
    publish)
        run_publish "$@"
        ;;
    tweet)
        run_publish x "$@"
        ;;
    ideas)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "from-comments" ] || [ "$SUBCOMMAND" = "generate-from-comments" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom ideas from-comments <video> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/ideas/comments/generate_ideas.py" "$@"
        elif [ "$SUBCOMMAND" = "from-outlier" ] || [ "$SUBCOMMAND" = "generate-from-outlier" ]; then
            if [ $# -eq 0 ]; then
                echo "Usage: phantom ideas from-outlier <video> [arguments]"
                exit 1
            fi
            uv run --project "$BASE_DIR" python "$BASE_DIR/ideas/generate_from_outlier.py" "$@"
        elif [ "$SUBCOMMAND" = "export" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/ideas/export_ideas_to_sheet.py" "$@"
        elif [ "$SUBCOMMAND" = "archive" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/ideas/archive_reviewed_ideas.py" "$@"
        else
            echo "Unknown ideas subcommand: $SUBCOMMAND"
            echo "Usage: phantom ideas from-comments <video> [arguments]"
            echo "       phantom ideas from-outlier <video> [arguments]"
            echo "       phantom ideas export [--file <path> | --idea <text>] [arguments]"
            echo "       phantom ideas archive [--dry-run]"
            exit 1
        fi
        ;;
    yt)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "upload" ]; then
            run_publish yt "$@"
        elif [ "$SUBCOMMAND" = "add-to-playlist" ] || [ "$SUBCOMMAND" = "addtoplaylist" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/youtube_api/addtoplaylist.py" "$@"
        elif [ "$SUBCOMMAND" = "count-uploads" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/youtube_api/count_youtube_uploads.py" "$@"
        elif [ "$SUBCOMMAND" = "titles" ] || [ "$SUBCOMMAND" = "print-titles" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/youtube_api/print_titles.py" "$@"
        elif [ "$SUBCOMMAND" = "summarize" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/ideas/summarize_video.py" "$@"
        elif [ "$SUBCOMMAND" = "comments" ] || [ "$SUBCOMMAND" = "scrape-comments" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/ideas/comments/scrape_comments.py" "$@"
        elif [ "$SUBCOMMAND" = "info" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/youtube_api/video_info.py" "$@"
        elif [ "$SUBCOMMAND" = "channel-stats" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/youtube_api/channel_stats.py" "$@"
        elif [ "$SUBCOMMAND" = "endscreen" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/youtube_api/add_endscreen.py" "$@"
        else
            echo "Unknown yt subcommand: $SUBCOMMAND"
            echo "Usage: phantom yt add-to-playlist <video> <playlist_id_or_name> [--privacy <public|unlisted|private>]"
            echo "       phantom yt count-uploads [<channel>] [--fresh]"
            echo "       phantom yt titles [<channel>] [--fresh] [--limit <int>] [--numbered] [--reverse] [--with-id] [--json]"
            echo "       phantom yt summarize <video> [--model <model>] [--json]"
            echo "       phantom yt comments <video> [--limit <int>] [--order <relevance|time>] [--json]"
            echo "       phantom yt info <video> [--fresh] [--json] [--days <int>]"
            echo "       phantom yt channel-stats [--fresh] [--json] [--history]"
            echo "       phantom yt endscreen <video>... [--template <name>] [--dry-run]"
            exit 1
        fi
        ;;
    shorts|threads)
        removed_command "$COMMAND"
        ;;
    docs)
        SUBCOMMAND="$1"
        shift
        
        open_url() {
            local url="$1"
            if command -v explorer.exe >/dev/null 2>&1; then
                explorer.exe "$url" >/dev/null 2>&1 || true
            elif command -v xdg-open >/dev/null 2>&1; then
                xdg-open "$url" >/dev/null 2>&1 || true
            else
                python3 -m webbrowser "$url" >/dev/null 2>&1 || true
            fi
        }

        if [ "$SUBCOMMAND" = "open" ]; then
            # Check if port 8000 is already in use
            if python3 -c "import socket; s = socket.socket(socket.AF_INET, socket.SOCK_STREAM); s.settimeout(1); s.connect(('127.0.0.1', 8000))" 2>/dev/null; then
                echo "Docs server is already running on http://127.0.0.1:8000"
                echo "Opening browser..."
                open_url "http://127.0.0.1:8000"
                exit 0
            else
                echo "Starting docs server on http://127.0.0.1:8000..."
                uv run --project "$BASE_DIR" mkdocs serve &
                SERVER_PID=$!
                
                # Set trap to ensure server is cleaned up when script exits
                trap 'kill $SERVER_PID 2>/dev/null' EXIT INT TERM
                
                # Wait 2 seconds for server to start
                sleep 2
                
                echo "Opening browser..."
                open_url "http://127.0.0.1:8000"
                
                # Keep script running to show server output
                wait $SERVER_PID
            fi
        else
            echo "Unknown docs subcommand: $SUBCOMMAND"
            echo "Usage: phantom docs open"
            exit 1
        fi
        ;;
    review)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "inspect" ]; then
            exec "$0" edit inspect-video "$@"
        elif [ "$SUBCOMMAND" = "audio" ]; then
            exec "$0" edit review-audio "$@"
        else
            echo "Unknown review subcommand: $SUBCOMMAND"
            echo "Usage: phantom edit inspect-video <video_path> [arguments]"
            echo "       phantom edit review-audio <video_or_audio_path> [arguments]"
            exit 1
        fi
        ;;
    content)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "yap" ]; then
            run_publish yap "$@"
        else
            echo "Unknown content subcommand: $SUBCOMMAND"
            echo "Usage: phantom publish yap --platform <linkedin|substack>"
            exit 1
        fi
        ;;
    substack)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "note" ]; then
            run_publish substack "$@"
        else
            echo "Unknown substack subcommand: $SUBCOMMAND"
            echo "Usage: phantom publish substack [<text>] [-f <file>] [-i <images>...] [-v <video>] [--headless]"
            exit 1
        fi
        ;;
    linkedin)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "post" ] || [ "$SUBCOMMAND" = "new-post" ]; then
            run_publish linkedin "$@"
        else
            echo "Unknown linkedin subcommand: $SUBCOMMAND"
            echo "Usage: phantom publish linkedin [<text>] [-f <file>] [-i <images>...] [--url <url>]"
            exit 1
        fi
        ;;
    devto)
        SUBCOMMAND="$1"
        shift
        if [ "$SUBCOMMAND" = "post" ]; then
            run_publish devto "$@"
        else
            echo "Unknown devto subcommand: $SUBCOMMAND"
            echo "Usage: phantom publish devto <markdown_file> [-t <title>] [--tags <tags>...] [-c <cover>] [--canonical-url <url>] [--series <name>] [--schedule \"YYYY-MM-DD HH:MM\"] [--draft]"
            exit 1
        fi
        ;;
    broll)
        SUBCOMMAND="$1"
        if [ "$SUBCOMMAND" = "list" ] || [ "$SUBCOMMAND" = "find" ] || [ "$SUBCOMMAND" = "render" ] || [ "$SUBCOMMAND" = "clip" ]; then
            uv run --project "$BASE_DIR" python "$BASE_DIR/broll-templates/broll.py" "$@"
        else
            echo "Unknown broll subcommand: $SUBCOMMAND"
            echo "Usage: phantom broll list [<template>]"
            echo "       phantom broll find <phrase> [--srt <word_srt>] [--after <timestamp>]"
            echo "       phantom broll render <cue_file.json> [--srt <word_srt>] [--only <file>...] [--dry-run] [--force]"
            echo "       phantom broll clip <template> -o <output.mp4> [--cue <phrase>] [--until <phrase>] [--var key=value...] [arguments]"
            exit 1
        fi
        ;;
    help|--help|-h)
        show_usage
        exit 0
        ;;
    *)
        echo "Unknown command: $COMMAND"
        show_usage
        exit 1
        ;;
esac
