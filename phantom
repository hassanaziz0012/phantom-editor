    echo "    summarize <video> [--model <model>] [--json]"
    echo "    comments <video> [--limit <int>] [--order <relevance|time>] [--json]"
    echo "    info <video> [--fresh] [--json] [--days <int>]"
    echo "    channel-stats [--fresh] [--json] [--history]"
    echo "    endscreen <video>... [--template <name>] [--dry-run]"
