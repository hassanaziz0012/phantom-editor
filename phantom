#!/bin/bash

# Base directory of the project codebase.
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
if [ -f "$SCRIPT_DIR/audio-processing/process_audio.sh" ]; then
    BASE_DIR="$SCRIPT_DIR"
else
    BASE_DIR="/home/hassan/Desktop/programming/phantom-editor"
fi

# Clean up external VIRTUAL_ENV so uv targets the project environment without warnings
unset VIRTUAL_ENV

