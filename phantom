    echo "Usage: phantom <command> [arguments]"
    echo ""
    echo "Commands:"
    echo "  projects:"
    echo "    status [arguments]"
    echo "    process <raw_video> [arguments]"
    echo "    newvideo <project_name>"
    echo "    cleanup [<project_path>] [--full]"
    echo ""
    echo "  edit:"
